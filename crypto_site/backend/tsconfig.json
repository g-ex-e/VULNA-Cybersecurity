{
  "compilerOptions": {
    "target": "ES2019",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],    // 👈 Important
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts"]
}

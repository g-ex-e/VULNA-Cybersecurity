<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>Profil - CorpHub</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-orange-50 min-h-screen p-8 font-sans text-gray-800">
  <div class="max-w-5xl mx-auto">

    <!-- Header -->
    <header class="flex justify-between items-center mb-8">
      <div>
        <h1 class="text-3xl font-bold text-red-700">🎉 Bienvenue <%= user.username %></h1>
        <p class="text-sm text-gray-600">Rôle : <%= user.role %></p>
      </div>
      <div class="space-x-4">
        <a href="/" class="text-sm text-red-600 underline">🏠 Accueil</a>
        <a href="/logout" class="text-sm text-red-500 underline">🚪 Déconnexion</a>
      </div>
    </header>

    <!-- Info utilisateur -->
    <section class="bg-white rounded shadow p-6 border-l-4 border-orange-400 mb-10">
      <h2 class="text-xl font-semibold mb-2 text-orange-700">👤 Informations</h2>
      <p class="mb-1"><strong>Nom d'utilisateur :</strong> <%= user.username %></p>
      <p><strong>Rôle :</strong> <%= user.role %></p>
    </section>

    <% if (user.role === 'admin') { %>
  <!-- Interface de gestion des tickets -->
  <section class="bg-white rounded shadow p-6 border-l-4 border-yellow-400">
    <h2 class="text-xl font-semibold text-yellow-700 mb-4">🎫 Gérer les tickets</h2>

    <ul class="space-y-4">
      <li class="bg-yellow-50 border-l-4 border-yellow-600 p-4 rounded shadow-sm">
        <h3 class="font-bold text-yellow-800">[#1021] Problème d'accès à la messagerie interne</h3>
        <p class="text-sm text-gray-700 mt-1">💬 <strong>Employée :</strong> Julie Marin — "Je ne reçois plus mes notifications internes depuis lundi."</p>
        <p class="text-xs text-gray-400 mt-2 italic">Assigné à : support IT</p>
      </li>

      <li class="bg-yellow-50 border-l-4 border-yellow-600 p-4 rounded shadow-sm">
        <h3 class="font-bold text-yellow-800">[#1022] Mauvais affichage du calendrier RH</h3>
        <p class="text-sm text-gray-700 mt-1">💬 <strong>Manager :</strong> Maxime Roux — "Le calendrier des congés est vide malgré plusieurs demandes validées."</p>
        <p class="text-xs text-gray-400 mt-2 italic">Assigné à : service RH</p>
      </li>

      <li class="bg-yellow-50 border-l-4 border-yellow-600 p-4 rounded shadow-sm">
        <h3 class="font-bold text-yellow-800">[#1023] Anomalie dans le calcul des heures supplémentaires</h3>
        <p class="text-sm text-gray-700 mt-1">💬 <strong>Employé :</strong> Théo Bernard — "Mes heures sup du mois dernier ne sont pas affichées correctement."</p>
        <p class="text-xs text-gray-400 mt-2 italic">Assigné à : service paie</p>
      </li>
    </ul>
  </section>
    <% } else { %>
      <!-- Documents pour tous sauf admin -->
      <section class="bg-white rounded shadow p-6 border-l-4 border-red-400">
        <h2 class="text-xl font-semibold text-red-700 mb-4">📁 Vos documents</h2>

        <% if (docs.length === 0) { %>
          <p class="text-gray-500 italic">Aucun document disponible pour le moment.</p>
        <% } else { %>
          <ul class="space-y-3">
            <% docs.forEach(doc => { %>
              <li class="flex items-center justify-between bg-gray-50 border border-red-200 rounded px-4 py-3 hover:bg-orange-50 transition">
                <span class="text-gray-800"><%= doc.title %></span>

                <% if (user.role !== 'manager') { %>
                  <button onclick="alert('⛔ Accès refusé : seuls les rôles : manager peuvent consulter ce document.')" 
                    class="bg-gray-300 text-gray-700 px-4 py-2 rounded font-medium cursor-not-allowed shadow-sm">
                    Accès refusé
                  </button>
                <% } else { %>
                  <a href="/d0cs842k/<%= doc.id %>" 
                    class="bg-red-600 text-white px-4 py-2 rounded hover:bg-red-700 font-medium shadow">
                    Accéder
                  </a>
                <% } %>
              </li>
            <% }) %>
          </ul>
        <% } %>
      </section>
    <% } %>
  </div>
</body>
</html>

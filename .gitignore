# ============================================================
# VULNA Cybersecurity — Git ignore rules
# ============================================================

# Dependencies
node_modules/
**/node_modules/
.pnp/
.pnp.js

# Frontend / build outputs
build/
**/build/
dist/
**/dist/
.vite/
**/.vite/
coverage/
**/coverage/
.cache/
**/.cache/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local environment files
.env
**/.env
.env.local
**/.env.local
.env.*.local
**/.env.*.local

# Keep documented templates
!.env.example
!**/.env.example

# Python
__pycache__/
**/__pycache__/
*.py[cod]
.venv/
venv/

# Local database transient files
*.db-journal
*.sqlite-journal
*.sqlite3-journal

# Editors / IDEs
.vscode/
.idea/
*.swp
*.swo

# OS metadata
.DS_Store
Thumbs.db
desktop.ini

# Temporary / generated files
*.tmp
*.temp
*.bak
*.pid

# Local archives and exports
*.rar

# GitHub-ready documentation assets under docs/ are intentionally tracked.
